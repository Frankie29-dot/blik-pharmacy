# Copy this file to .env and fill in real values. Never commit .env.

# Neon PostgreSQL connection (use the pooled connection string from Neon).
# Change postgres:// to postgresql+psycopg:// for SQLAlchemy.
# Keep sslmode=require. Do not commit the real password or this file with secrets.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Signs staff login tokens. Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The website that is allowed to call this API from a browser.
# Exact origin only: scheme + domain, no path, no trailing slash.
# Several origins can be comma-separated, e.g. a www and a non-www domain.
CORS_ORIGINS=https://your-site.example

# Staff login tokens last this long (minutes). 480 = one working day.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Per-IP limits, requests per minute.
REFILL_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_MINUTE=10
